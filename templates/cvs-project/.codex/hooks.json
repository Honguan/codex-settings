{
  "description": "CVS project hooks that preserve CRLF line endings for files updated by Codex.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command '$d=[IO.DirectoryInfo](Get-Location).Path;while($null -ne $d -and -not (Test-Path -LiteralPath (Join-Path $d.FullName \".codex-root\"))){$d=$d.Parent};if($null -ne $d){& (Join-Path $d.FullName \".codex/hooks/crlf-updated-files.ps1\")}'",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$d=[IO.DirectoryInfo](Get-Location).Path;while($null -ne $d -and -not (Test-Path -LiteralPath (Join-Path $d.FullName '.codex-root'))){$d=$d.Parent};if($null -ne $d){& (Join-Path $d.FullName '.codex\\hooks\\crlf-updated-files.ps1')}\"",
            "timeout": 30,
            "statusMessage": "Normalizing updated files to CRLF"
          }
        ]
      }
    ]
  }
}
