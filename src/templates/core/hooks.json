{
  "description": "Codex Settings global lifecycle hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \"$HOME/.codex/hooks/show-codex-notification.ps1\" -Type QuestionRequired",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.codex\\hooks\\show-codex-notification.ps1\" -Type QuestionRequired",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \"$HOME/.codex/hooks/show-codex-notification.ps1\" -Type PermissionRequired",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.codex\\hooks\\show-codex-notification.ps1\" -Type PermissionRequired",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
