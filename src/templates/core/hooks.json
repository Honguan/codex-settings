{
  "description": "Codex Settings global lifecycle hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command '& (Join-Path $HOME \".codex/hooks/show-codex-notification.ps1\") -Type QuestionRequired'",
            "commandWindows": "pwsh.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $HOME '.codex\\hooks\\show-codex-notification.ps1') -Type QuestionRequired\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command '& (Join-Path $HOME \".codex/hooks/show-codex-notification.ps1\") -Type PermissionRequired'",
            "commandWindows": "pwsh.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $HOME '.codex\\hooks\\show-codex-notification.ps1') -Type PermissionRequired\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command '& (Join-Path $HOME \".codex/hooks/show-codex-notification.ps1\") -Type Completed'",
            "commandWindows": "pwsh.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $HOME '.codex\\hooks\\show-codex-notification.ps1') -Type Completed\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
