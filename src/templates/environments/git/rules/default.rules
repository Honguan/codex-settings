# Git project rules supplement the global rules.

# 1. Block CVS.
prefix_rule(
    pattern = [["cvs", "cvs.exe"]],
    decision = "forbidden",
    justification = "This project uses Git, not CVS.",
)

# 2. Block Subversion.
prefix_rule(
    pattern = [["svn", "svn.exe"]],
    decision = "forbidden",
    justification = "This project uses Git, not Subversion.",
)

# 3. Block Mercurial.
prefix_rule(
    pattern = [["hg", "hg.exe"]],
    decision = "forbidden",
    justification = "This project uses Git, not Mercurial.",
)

# 4. Block Fossil.
prefix_rule(
    pattern = [["fossil", "fossil.exe"]],
    decision = "forbidden",
    justification = "This project uses Git, not Fossil.",
)

# 5. Allow Git inspection.
prefix_rule(
    pattern = [["git", "git.exe"], ["status", "diff", "log", "show", "rev-parse", "ls-files", "ls-tree", "blame"]],
    decision = "allow",
    justification = "Allow read-only Git repository inspection.",
)

# 6. Confirm Git mutations.
prefix_rule(
    pattern = [["git", "git.exe"], ["add", "commit", "push", "pull", "fetch", "merge", "rebase", "checkout", "switch", "restore", "reset", "clean", "branch", "tag", "stash", "cherry-pick", "revert", "worktree", "submodule"]],
    decision = "prompt",
    justification = "Confirm Git operations that may change the working tree, history, index, or remote state.",
)

# 7. Block hard reset.
prefix_rule(
    pattern = [["git", "git.exe"], ["reset"], ["--hard"]],
    decision = "forbidden",
    justification = "Hard reset can discard local work.",
)

# 8. Block forced clean.
prefix_rule(
    pattern = [["git", "git.exe"], ["clean"], ["-f", "-fd", "-df", "-fdx", "-xdf", "-ff", "-ffdx"]],
    decision = "forbidden",
    justification = "Forced clean can delete untracked files.",
)

# 9. Block force push.
prefix_rule(
    pattern = [["git", "git.exe"], ["push"], ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force push rewrites remote history.",
)

# 10. Confirm GitHub Actions mutations.
prefix_rule(
    pattern = [["gh", "gh.exe"], ["workflow", "run"], ["enable", "disable", "run", "delete", "rerun", "cancel"]],
    decision = "prompt",
    justification = "Confirm GitHub Actions workflow changes, cancellations, and reruns.",
)

# 11. Confirm GitHub collaboration mutations.
prefix_rule(
    pattern = [["gh", "gh.exe"], ["pr", "issue", "release"], ["create", "edit", "close", "reopen", "delete", "merge", "review", "ready", "comment", "lock", "unlock", "checkout", "upload"]],
    decision = "prompt",
    justification = "Confirm pull request, issue, and release operations that modify local or remote state.",
)

# 12. Confirm package scripts.
prefix_rule(
    pattern = [["npm", "npm.cmd", "pnpm", "pnpm.cmd", "yarn", "yarn.cmd", "bun", "bun.exe"], ["run", "test", "exec", "dlx", "x"]],
    decision = "prompt",
    justification = "Confirm package scripts and executable runners because they execute project code.",
)

# 13. Confirm dependency mutations.
prefix_rule(
    pattern = [["npm", "npm.cmd", "pnpm", "pnpm.cmd", "yarn", "yarn.cmd", "bun", "bun.exe"], ["install", "i", "add", "remove", "uninstall", "update", "upgrade", "publish", "link"]],
    decision = "prompt",
    justification = "Confirm dependency and package publication changes.",
)
