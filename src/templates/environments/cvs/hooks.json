{
  "description": "Convert modified CVS text files to CRLF when Codex finishes.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command '& (Join-Path $HOME \".codex/hooks/normalize-cvs-crlf.ps1\")'",
            "commandWindows": "pwsh.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $HOME '.codex\\hooks\\normalize-cvs-crlf.ps1')\"",
            "timeout": 60,
            "statusMessage": "CodexSettings CRLF finalize"
          }
        ]
      }
    ]
  }
}
