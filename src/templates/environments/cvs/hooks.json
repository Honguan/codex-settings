{
  "description": "Restore mixed line endings after Codex finishes.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command '& (Join-Path $HOME \".codex/hooks/preserve-line-endings.ps1\")'",
            "commandWindows": "pwsh.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $HOME '.codex\\hooks\\preserve-line-endings.ps1')\"",
            "timeout": 60,
            "statusMessage": "Restoring original line endings"
          }
        ]
      }
    ]
  }
}
