{
  "description": "Preserve original line endings for files modified by Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \"$HOME/.codex/hooks/preserve-line-endings.ps1\" -Mode Track",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.codex\\hooks\\preserve-line-endings.ps1\" -Mode Track",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \"$HOME/.codex/hooks/preserve-line-endings.ps1\" -Mode Restore",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.codex\\hooks\\preserve-line-endings.ps1\" -Mode Restore",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \"$HOME/.codex/hooks/preserve-line-endings.ps1\" -Mode Finalize",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.codex\\hooks\\preserve-line-endings.ps1\" -Mode Finalize",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
